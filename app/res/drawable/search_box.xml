<?xml version="1.0" encoding="utf-8"?>
<!--
  Input field for the dark UI. The platform default EditText background is a
  light box, which made the white text invisible against it, so the field is
  drawn explicitly instead.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/panel" />
    <stroke
        android:width="1dp"
        android:color="@color/divider" />
    <corners android:radius="4dp" />
    <padding
        android:left="8dp"
        android:top="6dp"
        android:right="8dp"
        android:bottom="6dp" />
</shape>
